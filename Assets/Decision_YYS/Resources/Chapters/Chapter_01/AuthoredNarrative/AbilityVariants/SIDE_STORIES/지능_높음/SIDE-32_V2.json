      "hover": {
        "trigger": "mouse_hover",
        "hide_on": "mouse_exit",
        "calculate_from_current_stats": true,
        "source": "00_implementation_rules.json#requirement_probability.probability_formula",
        "calculate": "clamp(0.50 + 0.10 * (0.75 * current_primary + 0.25 * current_secondary - difficulty), 0.10, 0.90)",
        "recalculate_on_attempt": true,
        "display": "{calculated_probability_percent}%"
      }
    },
