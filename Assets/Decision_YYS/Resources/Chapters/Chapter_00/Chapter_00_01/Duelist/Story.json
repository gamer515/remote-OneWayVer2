  "duelist": {
    "MainStory": [
      {
        "ID": -1255577364,
        "type": "Next",
        "Text": "우선 보드 가운데에 자네를 대신할 연습용 기사를 세워두지.",
        "speakID": "Duelist"
      },
      {
        "ID": -1238799745,
        "type": "Next",
        "Text": "저 기사를 자네 몸이라 생각하게. 검이 어디로 들어오는지 잘 살펴보라고.",
