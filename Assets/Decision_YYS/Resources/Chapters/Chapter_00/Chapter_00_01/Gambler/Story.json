  "gambler": {
    "MainStory": [
      {
        "ID": -862278604,
        "type": "Next",
        "Text": "기어로 앞면이나 뒷면을 선택한 뒤 노란 버튼을 누르게.",
        "speakID": "Gambler"
      },
      {
        "ID": -845500985,
