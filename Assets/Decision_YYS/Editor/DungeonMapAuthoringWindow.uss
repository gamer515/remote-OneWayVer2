.map-scroll {
    flex-grow: 1;
    padding: 6px;
}
.tile-catalog {
    flex-direction: row;
    flex-wrap: wrap;
}
.tile-button {
    width: 100px;
    min-height: 80px;
    margin: 3px;
}
.tile-preview {
    height: 48px;
}
.tile-name {
    white-space: normal;
    -unity-text-align: middle-center;
}
