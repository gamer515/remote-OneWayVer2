  subtleChangeInstruction: "\uD575\uC2EC \uC0AC\uAC74\uC740 \uC720\uC9C0\uD558\uACE0
    \uBB38\uC7A5\uC758 \uC5B4\uC870\uC640 \uC8FC\uBCC0 \uBB18\uC0AC\uB97C \uBBF8\uC138\uD558\uAC8C
    \uC870\uC815\uD569\uB2C8\uB2E4."
  moderateChangeInstruction: "\uD575\uC2EC \uC0AC\uAC74\uC740 \uC720\uC9C0\uD558\uB418
    \uBB38\uC7A5\uACFC \uC8FC\uBCC0 \uBB18\uC0AC\uC5D0 \uC8FC\uC694\xB7\uBCF4\uC870
    \uC57D\uC810\uC774 \uB4DC\uB7EC\uB098\uB3C4\uB85D \uC870\uC815\uD569\uB2C8\uB2E4."
  strongChangeInstruction: "\uC774\uC57C\uAE30 \uC21C\uC11C\uC640 \uBAA9\uC801\uC9C0\uB294
    \uC720\uC9C0\uD558\uBA74\uC11C, \uC120\uD0DD \uACB0\uACFC\uAC00 \uBD84\uBA85\uD558\uAC8C
    \uB290\uAEF4\uC9C0\uB3C4\uB85D \uC7A5\uBA74\uC758 \uBB18\uC0AC\uC640 \uAE34\uC7A5\uAC10\uC744
    \uAC15\uD558\uAC8C \uC870\uC815\uD569\uB2C8\uB2E4."
  episodeEndTemplate: "\uC5D0\uD53C\uC18C\uB4DC\uAC00 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n[\uC694\uCCAD
    \uC0AC\uD56D]\n\uD50C\uB808\uC774 \uACB0\uACFC\uC640 \uBCC0\uACBD \uAC15\uB3C4\uC5D0
    \uB9DE\uCDB0 \uB2E4\uC74C \uD68C\uCC28\uC5D0\uC11C \uC0AC\uC6A9\uD560 \uAC19\uC740
    \uC5D0\uD53C\uC18C\uB4DC\uC758 \uD45C\uD604\uC744 \uC218\uC815\uD574 \uC8FC\uC138\uC694.\n\uC804\uCCB4\uC801\uC778
    \uBD84\uC704\uAE30\uB294 '{1}'\uC785\uB2C8\uB2E4.\n\n[\uC804\uB2EC\uB41C \uC9C0\uBB38
    \uAE30\uB85D]\n{0}\n\n[\uC81C\uC57D \uC870\uAC74]\n{2}"
  midTransitionTemplate: "\uC911\uAC04\uC5D0 \uC774\uC57C\uAE30\uAC00 \uB04A\uACBC\uC2B5\uB2C8\uB2E4.\n\n[\uC694\uCCAD
    \uC0AC\uD56D]\n\uC804\uCCB4\uC801\uC778 \uBD84\uC704\uAE30\uB97C '{1}'(\uC73C)\uB85C
    \uC218\uC815\uD574 \uC8FC\uC138\uC694.\n\n[\uC804\uB2EC\uB41C \uC9C0\uBB38 \uAE30\uB85D]\n{0}\n\n[\uC81C\uC57D
    \uC870\uAC74]\n{2}"
  chapterEndTemplate: "\uCC55\uD130\uAC00 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n[\uC694\uCCAD
    \uC0AC\uD56D]\n\uC804\uCCB4\uC801\uC778 \uBD84\uC704\uAE30\uB97C '{1}'(\uC73C)\uB85C
    \uC218\uC815\uD574 \uC8FC\uC138\uC694.\n\n[\uC804\uB2EC\uB41C \uC9C0\uBB38 \uAE30\uB85D]\n{0}\n\n[\uC81C\uC57D
    \uC870\uAC74]\n{2}"
  lowStatAtmosphere: "\uBD80\uB4DC\uB7FD\uACE0 \uC628\uD654\uD558\uBA70 \uAC10\uC131\uC801\uC778
    \uBD84\uC704\uAE30"
  midStatAtmosphere: "\uD3C9\uC628\uD558\uBA74\uC11C\uB3C4 \uBB34\uAC8C\uAC10\uC774
    \uB290\uAEF4\uC9C0\uB294 \uADE0\uD615 \uC7A1\uD78C \uBD84\uC704\uAE30"
  highStatAtmosphere: "\uAC15\uB82C\uD558\uACE0 \uAE34\uBC15\uD558\uBA70 \uC555\uB3C4\uC801\uC778
    \uAE30\uC6B4\uC774 \uB290\uAEF4\uC9C0\uB294 \uBD84\uC704\uAE30"
  responseFormatTemplateV2: "1. \uBAA8\uB4E0 \uB300\uC0AC\uC758 text\uB294 \uC0C8\uB86D\uAC8C
    \uD45C\uD604\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n2. \uB2E8, \uC6D0\uBCF8
    text\uC758 { }\uC640 \uADF8 \uB0B4\uBD80 \uBB38\uC790\uC5F4\uC740 \uD575\uC2EC
    \uC124\uC815\uC774\uBBC0\uB85C \uC21C\uC11C\uC640 \uB0B4\uC6A9\uC744 \uD55C \uAE00\uC790\uB3C4
    \uBCC0\uACBD\uD558\uC9C0 \uB9C8\uC138\uC694.\n3. id, \uC774\uC57C\uAE30 \uC21C\uC11C,
    \uC120\uD0DD\uC9C0, destination, character, type\uC740 \uBCC0\uACBD\uD558\uC9C0
    \uB9C8\uC138\uC694.\n4. \uC751\uB2F5\uC740 \uBC18\uB4DC\uC2DC \uC544\uB798 JSON
    \uBC30\uC5F4\uB9CC \uCD9C\uB825\uD558\uC138\uC694.\n[ { \"id\": ID\uAC12, \"text\":
    \"{\uD575\uC2EC \uBB38\uC790\uC5F4}\uC744 \uADF8\uB300\uB85C \uBCF4\uC874\uD55C
    \uC218\uC815 \uBB38\uC7A5\" } ]"
