# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Local inference payloads are restored by AgentScripts/SetupLocalStoryModel.ps1.
/AgentScripts/ConnectLearningDispenser.cs
# Keep model/runtime out of Git; Windows builds include them through StreamingAssets.
/Assets/StreamingAssets/LocalStory/*.gguf
/Assets/StreamingAssets/LocalStory/*.gguf.meta
/Assets/StreamingAssets/LocalStory/runtimes/
/Assets/StreamingAssets/LocalStory/runtimes.meta

# Locally installed comparison models and the Gemma build source stay outside Assets/Git.
# The Windows build processor copies only the verified Gemma payload into the Player.
/Tests/LocalStoryBenchmark/Models/

# Local authoring and generated document artifacts
# Keep local planning, review notes, and retired content out of the game repository.
*.md
*.md.meta
!**/LICENSE.md
!**/LICENSE.md.meta
!**/LICENCE.md
!**/LICENCE.md.meta
!**/NOTICE.md
!**/NOTICE.md.meta
/Docs/
/Documentation/
/Archive/
/AgentScripts/Backups/
__pycache__/
*.pyc
*.slnx
/tmp/
/outputs/
/AgentScripts/StoryWorkbook/node_modules/
/AgentScripts/StoryWorkbook/qa/
/Assets/StreamingAssets/LocalStory/*.inspect.ndjson*
/output/
# Preserve the existing game report, manual and their local evidence.
!/output/
/output/*
!/output/UIRevision/
/output/UIRevision/*
!/output/UIRevision/index.html
!/output/UIRevision/*.png
!/output/UIRevision/*checks.json
!/output/UIRevision/*check.json
!/output/UIRevision/inspector-paths.json
!/output/UIRevision/arm-comparison.json
!/output/MineChapterReview/
/output/MineChapterReview/*
!/output/MineChapterReview/index.html
!/output/MineChapterReview/work-history.html
!/output/MineChapterReview/usage-guide.html
!/output/MineChapterReview/cleanup-result.json
!/output/MineChapterReview/14-dialogue-layout.png
!/output/MineChapterReview/15-choice-center.png
!/output/MineChapterReview/16-duel-contact.png
!/output/MineChapterReview/layout-choice-check.json
!/output/MineChapterReview/duel-movement-check.json
!/output/MineChapterReview/duel-contact-check.json
!/output/MineChapterReview/duel-user-adjusted-pose.json
!/output/MineChapterReview/17-choice-lower-fit.png
!/output/MineChapterReview/18-mouse-guard.png
!/output/MineChapterReview/choice-sizing-check.json
!/output/MineChapterReview/mouse-defense-check.json
!/output/MineChapterReview/hand-depth-user-pose.json
!/output/MineChapterReview/19-npc-depth-guard.png
!/output/MineChapterReview/20-hero-choice.png
!/output/MineChapterReview/npc-adjusted-input-check.json
!/output/MineChapterReview/hero-label-check.json
!/output/MineChapterReview/npc-hand-user-pose.json
/.codex-finalizer-*/

# Generated caches from all nested authoring/validation Unity projects
/AssetBuild/**/[Ll]ibrary/
/AssetBuild/**/[Ll]ogs/
/AssetBuild/**/[Tt]emp/
/AssetBuild/**/[Uu]ser[Ss]ettings/
/AssetBuild/BlenderTools/

# Knight desk dismount: keep source, final FBX/Blend, tools and usage guide.
# Rendered previews and validation output can be regenerated locally.
!/AssetBuild/KnightRigFix/DeskDismount/README.md
/AssetBuild/KnightRigFix/DeskDismount/*.blend[0-9]*
/AssetBuild/KnightRigFix/DeskDismount/pose_*.png
/AssetBuild/KnightRigFix/DeskDismount/motion_preview.png
/AssetBuild/KnightRigFix/DeskDismount/*_preview.mp4
/AssetBuild/KnightRigFix/DeskDismount/validation.json

# MemoryCaptures can get excessive in size.
# Preserve the knight integration report's selected play-mode evidence.
!/output/KnightAnimationReview/
/output/KnightAnimationReview/*
!/output/KnightAnimationReview/0[1-6]-*.png
!/output/KnightAnimationReview/checks.json

# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
# TextMeshPro SDF fonts and their GUID metadata are required UI assets.
# Track them so scene and prefab font references resolve on other machines.

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

